+// Shim to bridge older @solana/web3.js variants (1.73 / 1.77 / 1.87) which
+// `require('rpc-websockets/dist/lib/client')`. rpc-websockets@7.11.2 ships
+// only a `.cjs` file at this path, and Node's CJS resolver does not auto-try
+// the `.cjs` extension for bare requires. This shim re-exports from `.cjs`.
+//
+// Patched via patches/rpc-websockets+7.11.2.patch — referenced from
+// pnpm.patchedDependencies in the workspace root package.json.
+module.exports = require("./client.cjs");
