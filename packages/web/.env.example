NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_STRATEGY_PROGRAM_ID=
NEXT_PUBLIC_PREDICTION_PROGRAM_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# .bundie SNS root — public values, override only for non-default deploys.
# Defaults baked into lib/sns-register.ts target the devnet root created by
# `pnpm --filter @bundie/programs chaos:setup-root`.
NEXT_PUBLIC_BUNDIE_ROOT_PDA=4ZKCQT1DgxQ7L4TggUMr4SS3zH4SLyVT1FWbCq4qrjEy
NEXT_PUBLIC_BUNDIE_ROOT_OWNER=8EodjSj73fUA2doL86CSRZzrFQUxJ9kBPNjDBo92hpH6

# Server-only — the bundie-root-owner secret key, used by the
# /api/sns/sign-as-root route to add the parent_owner signature for any
# `<name>.bundie` subdomain claim. JSON array of 64 bytes (the format
# `solana-keygen new` writes — copy the contents of
# packages/programs/scripts/chaos-sim/keys/bundie-root-owner.json verbatim).
# DO NOT prefix with NEXT_PUBLIC_ — keep this OFF the client bundle.
BUNDIE_ROOT_OWNER_SECRET_KEY=
