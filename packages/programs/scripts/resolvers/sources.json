  "next_to_add": [],
  "schema_notes": {
    "market_kind_proposed": "Maps to a new MARKET_KIND_* constant to be added in state/market.rs. Each kind has its own 64-byte payload layout \u2014 see state/market.rs docstring.",
    "resolver_class": "Routes to a specific resolver worker implementation in packages/backend/src/resolvers/. Each class consumes resolver_config and emits signed resolutions on trigger.",
    "comparator": "One of: lt, lte, gt, gte, eq. Applied to feed value vs threshold.",
    "rolling_window_seconds": "Resolver checks every poll if ANY contiguous window of this length within outcome_window_seconds breached the threshold.",
    "outcome_window_seconds": "Total time window during which the event can resolve. After this, market resolves NO unless YES triggered earlier.",
    "demo_eligible": "If true, this event is included in the Day-1 demo set (5 markets). Other events get added in subsequent days."
  },
