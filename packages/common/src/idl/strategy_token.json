{
  "address": "Bun4tBew11dWjx1mRuMmJZFmxsGsxYSYhdfe1w7JaHVm",
  "metadata": {
    "name": "strategy_token",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Bundie Strategy Token Program - Pinocchio program that mints tradeable shares tracking live portfolio value via Beethoven (Kamino, Marinade, Drift, Marginfi, Mango perps)",
    "docs": [
      "PINOCCHIO DISPATCH NOTE:",
      "This program is built with pinocchio (no Anchor framework). Each instruction is",
      "selected by a SINGLE u8 dispatch byte at the start of the instruction data, NOT",
      "an Anchor sha256(\"global:<name>\") 8-byte discriminator.",
      "",
      "To remain compatible with Anchor 0.30+ tooling (which expects an [u8; 8]",
      "discriminator) we encode the dispatch byte as the first element of an 8-byte",
      "array, padded with zeros: [byte, 0, 0, 0, 0, 0, 0, 0]. ONLY THE FIRST BYTE IS",
      "ON THE WIRE. Clients building txs must send a single byte (e.g. [1] for",
      "buy_shares) followed by the args bytes — DO NOT prepend the full 8-byte array.",
      "",
      "Account discriminators ARE 8 bytes and stored at offset 0 of each account:",
      "  Strategy          : [0xd0, 0x82, 0x35, 0xce, 0x9a, 0x7f, 0x5b, 0x11]",
      "  NavOracle         : [0xa1, 0x4e, 0x73, 0x20, 0xbc, 0x44, 0x61, 0x05]",
      "  PositionSnapshots : [0x7d, 0xa9, 0x1f, 0x4c, 0x62, 0x30, 0x8b, 0xe1]"
    ]
  },
  "instructions": [
    {
      "name": "create_strategy",
      "docs": [
        "Create a new strategy with its share mint, wallet PDA, and NAV oracle.",
        "Dispatch byte: 0. Real wire discriminator is the single byte 0x00."
      ],
      "discriminator": [0, 0, 0, 0, 0, 0, 0, 0],
      "accounts": [
        { "name": "creator", "writable": true, "signer": true },
        {
          "name": "strategy",
          "writable": true,
          "pda": {
            "seeds": [
              { "kind": "const", "value": [115, 116, 114, 97, 116, 101, 103, 121] },
              { "kind": "account", "path": "creator" },
              { "kind": "arg", "path": "name" }
            ]
          }
        },
        {
          "name": "mint",
          "docs": ["Strategy share mint — caller-supplied keypair, NOT a PDA"],
          "writable": true,
          "signer": true
        },
        {
          "name": "wallet",
          "docs": ["Wallet PDA that will custody portfolio assets"],
          "pda": {
            "seeds": [
              { "kind": "const", "value": [119, 97, 108, 108, 101, 116] },
              { "kind": "account", "path": "strategy" }
            ]
          }
        },
        {
          "name": "nav_oracle",
          "writable": true,
          "pda": {
            "seeds": [
              { "kind": "const", "value": [110, 97, 118] },
              { "kind": "account", "path": "strategy" }
            ]
          }
        },
        { "name": "deposit_mint", "docs": ["SPL mint of the strategy's quote/deposit token (e.g. USDC)"] },
        { "name": "protocol", "docs": ["Default routing protocol (e.g. Kamino program id)"] },
        { "name": "reserve", "docs": ["Default routing reserve / pool"] },
        { "name": "token_program", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" },
        { "name": "system_program", "address": "11111111111111111111111111111111" },
        { "name": "rent", "address": "SysvarRent111111111111111111111111111111111" }
      ],
      "args": [
        { "name": "strategy_type", "type": "u8", "docs": ["0 = YIELD, 1 = AGENT"] },
        { "name": "fee_bps", "type": "u16", "docs": ["Performance fee, basis points (max 10000)"] },
        { "name": "min_deposit", "type": "u64" },
        { "name": "name", "type": { "array": ["u8", 32] }, "docs": ["Fixed 32-byte name; pad with zeros"] }
      ]
    },
    {
      "name": "buy_shares",
      "docs": [
        "Deposit quote tokens, mint strategy shares pro-rata. For YIELD strategies,",
        "remaining accounts are the Beethoven deposit context (Kamino/Marinade/etc).",
        "Dispatch byte: 1."
      ],
      "discriminator": [1, 0, 0, 0, 0, 0, 0, 0],
      "accounts": [
        { "name": "buyer", "writable": true, "signer": true },
        { "name": "strategy", "writable": true },
        { "name": "mint", "docs": ["Strategy share mint"], "writable": true },
        {
          "name": "buyer_shares_ata",
          "docs": ["Buyer's ATA for the strategy share mint — created idempotently"],
          "writable": true
        },
        { "name": "wallet", "docs": ["Strategy wallet PDA — signs Beethoven CPIs"] },
        {
          "name": "wallet_token_ata",
          "docs": ["Wallet's ATA for the deposit token — created idempotently"],
          "writable": true
        },
        { "name": "buyer_token_ata", "docs": ["Buyer's deposit-token ATA"], "writable": true },
        { "name": "token_program", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" },
        { "name": "system_program", "address": "11111111111111111111111111111111" },
        { "name": "associated_token_program", "address": "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL" },
        { "name": "deposit_mint" }
      ],
      "args": [
        { "name": "amount", "type": "u64", "docs": ["Quote-token amount to deposit (base units)"] }
      ]
    },
    {
      "name": "redeem_shares",
      "docs": [
        "Burn shares, withdraw pro-rata quote tokens minus performance fee.",
        "For YIELD strategies, remaining accounts are the Kamino withdraw context.",
        "Dispatch byte: 2."
      ],
      "discriminator": [2, 0, 0, 0, 0, 0, 0, 0],
      "accounts": [
        { "name": "redeemer", "writable": true, "signer": true },
        { "name": "strategy", "writable": true },
        { "name": "mint", "writable": true },
        { "name": "redeemer_shares", "docs": ["Redeemer's share-token ATA (burned here)"], "writable": true },
