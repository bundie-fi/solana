shamefully-hoist=true
strict-peer-dependencies=false
# Don't hoist rpc-websockets — there are two versions in the tree (v7 for
# older @solana/web3.js variants pulled in by @zetamarkets/sdk, v9 for the
# top-level @solana/web3.js@^1.98). When the hoisted version is v9 (newest
# wins under shamefully-hoist), older web3.js variants walk up the
# resolution path and hit v9, which dropped the `./dist/lib/client`
# subpath — daemon crashes at startup. Excluding rpc-websockets from
# public hoisting lets each web3.js use its own nested version.
public-hoist-pattern[]=!rpc-websockets
